{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VietDesk Office",
  "version": "0.1.0",
  "identifier": "vn.vietdesk.office",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VietDesk Office",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$PICTURE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Bộ ứng dụng văn phòng VietDesk",
    "longDescription": "Writer, Sheets và Slides cho người dùng Việt Nam — hỗ trợ đầy đủ tiếng Việt và chuẩn văn bản hành chính."
  }
}
